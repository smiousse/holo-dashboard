    {
      "id": "kitchen",
      "name": "Kitchen",
      "icon": "kitchen",
      "floor": "rdc",
      "geometry": { "x": 4, "y": 18, "w": 22, "h": 22 },
      "entities": [
        { "kind": "light",  "id": "switch.smartswitchkitchen_left", "label": "Light" },
        { "kind": "light",  "id": "switch.switchkitchencounter",    "label": "Counter light" },
        { "kind": "thermo", "id": "climate.thermostatdiningroom",   "label": "Thermostat" }
      ]
    },
    {
      "id": "living_room",
      "name": "Living room",
      "icon": "sofa",
      "floor": "rdc",
      "geometry": { "x": 28, "y": 18, "w": 28, "h": 22 },
