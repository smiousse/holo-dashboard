{
  "$schema": "./config.schema.json",
  "version": 1,
  "language": "en",

  "connection": {
    "useRealHA": false,
    "url": "http://localhost:8123",
    "tokenStorageKey": "holohome.haToken.demo"
  },

  "weatherEntity": "weather.forecast_home",
  "outsideTempEntity": "sensor.tempsensorhomeoutside_temperature",
  "alarmEntity": "alarm_control_panel.blink_home",
  "refreshCamerasScript": "script.refresh_cameras_maison",

  "thermoColors": {
    "heating": "#fb3927",
    "heating_icon": "#9e0d04",
    "cooling": "#2badfb",
    "idle": "#656363",
    "idle_icon": "#000000"
  },

  "floors": [
    { "id": "rdc", "label": "UPPER" },
    { "id": "bas", "label": "BASEMENT" }
  ],

  "zones": [
    {
      "id": "garage",
      "name": "Garage",
      "icon": "garage-cover",
      "floor": "rdc",
      "geometry": { "x": 4, "y": 2, "w": 22, "h": 14 },
      "cover": { "id": "cover.gdo_home_door", "label": "Garage door" },
      "entities": [
        { "kind": "sensor", "id": "sensor.garage_humidity",    "label": "Humidity",    "unit": "%",  "icon": "humid",  "coloring": "humidity" },
        { "kind": "sensor", "id": "sensor.garage_temperature", "label": "Temperature", "unit": "°C", "icon": "thermo", "coloring": "temperature" }
      ]
    },
    {
      "id": "office",
      "name": "Office",
      "icon": "office",
      "floor": "rdc",
      "geometry": { "x": 58, "y": 2, "w": 22, "h": 14 },
      "entities": [
        {
          "kind": "printer",
          "id": "sensor.bambu_lab_a1_heure_de_fin",
          "stateEntity": "sensor.bambu_lab_a1_etat_de_l_impression",
          "label": "Bambu Lab A1"
        },
        { "kind": "thermo", "id": "climate.thermostat_office", "label": "Thermostat" }
